# Điền 2 biến Turso này vào Environment Variables trên Vercel để lưu DB chung cho cả team:
# Tạo miễn phí tại https://turso.tech (gói Free: 5GB storage, không tự pause)
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# (Tùy chọn) Đặt mã PIN để khóa tab Phân tích lỗi & nút Reset trong bảng Admin
# Để trống nếu không cần khóa PIN
ADMIN_PIN=
